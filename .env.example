# ─────────────────────────────────────────────────────────────────────────────
# LinkedIn MCP Server — configuration
# Copy to `.env` (local dev) OR set these as MCP-client env vars (recommended).
# ─────────────────────────────────────────────────────────────────────────────

# ── Option A: Bring Your Own Token (simplest; good for Amazon Quick Suite / headless) ──
# Generate at https://www.linkedin.com/developers/tools/oauth/token-generator
# Scopes: openid profile email w_member_social   (expires after 60 days)
LINKEDIN_ACCESS_TOKEN=

# ── Option B: Interactive OAuth 2.0 (PKCE) — server opens a browser, caches the token ──
# Create an app at https://developer.linkedin.com, add "Sign In with LinkedIn (OIDC)"
# and "Share on LinkedIn" products, then add this redirect URL in the Auth tab:
#   http://localhost:8765/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# OAuth loopback port the server listens on during the login flow (must match redirect URL).
LINKEDIN_OAUTH_PORT=8765
# Space-separated scopes to request during the interactive flow.
LINKEDIN_SCOPES=openid profile email w_member_social

# ── API versioning ──
# LinkedIn versioned REST API date header (YYYYMM). Bump when a version is retired.
LINKEDIN_API_VERSION=202606

# ── Transport ──
# stdio (default — Amazon Quick Desktop local connector, Amazon Q CLI, Claude Desktop)
# http  (streamable HTTP — for hosting behind Amazon Quick Suite cloud / AgentCore)
LINKEDIN_MCP_TRANSPORT=stdio
# When transport=http, the bind host/port (bind to 127.0.0.1 for local; 0.0.0.0 only when containerized).
LINKEDIN_MCP_HTTP_HOST=127.0.0.1
LINKEDIN_MCP_HTTP_PORT=8080

# ── Token cache location (interactive flow). Defaults to ~/.linkedin-mcp/token.json ──
# LINKEDIN_TOKEN_CACHE=

# ── Partner-scoped tool groups (OFF by default) ──────────────────────────────
# The server advertises only the 10 tools that work on self-serve
# w_member_social. The groups below need LinkedIn partner approval; enable a
# group only once your app is granted its scopes, otherwise the tools would
# just return a ScopeError.
#
# Adds linkedin_react / linkedin_unreact / linkedin_get_social_metadata.
# Needs Community Management: w_member_social_feed (+ r_member_social_feed,
# which LinkedIn grants to select developers only).
# LINKEDIN_ENABLE_SOCIAL_FEED=false
#
# Adds the 4 organization tools (lookup, vanity, follower stats, admined orgs).
# Needs Marketing/Organization scopes: r_organization_social /
# rw_organization_admin + a company Page admin role.
# LINKEDIN_ENABLE_ORG=false
